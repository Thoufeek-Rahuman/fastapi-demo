# Database Configuration
# Option 1: Use a full DATABASE_URL (recommended for cloud databases)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option 2: Use individual components (for local development)
# If DATABASE_URL is not set, these will be used instead
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crud
